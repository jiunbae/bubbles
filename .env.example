# Local Compose only. Replace every placeholder with an independent random value.
# Example generator: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-jwt-secret
# Temporary during a coordinated rotation; remove after the maximum token TTL.
JWT_SECRET_PREVIOUS=
SESSION_SECRET=replace-with-a-random-session-secret
# Temporary during rotation; matching cookies are re-signed with SESSION_SECRET.
SESSION_SECRET_PREVIOUS=
OWNER_ID_SECRET=replace-with-a-stable-random-owner-id-secret

# Optional. Required only when starting the `tunnel` profile.
CLOUDFLARE_TUNNEL_TOKEN=
